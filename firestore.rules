// REVIEW DRAFT ONLY. Not deployed. Existing administrators must be verified.
// Paired frontend required: comment mutations use atomic counters and lastCommentId.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/itlab_users/$(request.auth.uid)).data; }
    function admin() { return signedIn() && profile().get('isAdmin', false) == true; }
    function moderator() { return signedIn() && profile().get('isModerator', false) == true; }
    function categoryModerator(category) {
      return moderator() && category in profile().get('modCategories', []);
    }
    function settings() { return get(/databases/$(database)/documents/itlab_settings/general).data; }
    function canPost() {
      return signedIn() && (admin() || settings().get('postPermission', 'admin') == 'all'
        || (settings().get('postPermission', 'admin') == 'moderator' && moderator()));
    }
    function chatMember() {
      return signedIn() && (admin() || moderator() || profile().get('chatAuthorized', false) == true
        || exists(/databases/$(database)/documents/itlab_chat_access/$(request.auth.uid)));
    }
    function chatOpen() { return chatMember() && settings().get('chatEnabled', false) == true; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validClaim(code, uid) {
      let path = /databases/$(database)/documents/itlab_invitations/$(code);
      let before = get(path).data;
      let invite = getAfter(path).data;
      return before.get('isUsed', true) == false && invite.get('type', '') == 'chat' && invite.get('isUsed', false) == true
        && invite.get('usedBy', '') == uid;
    }
    function canDeleteComment(c) {
      let post = get(/databases/$(database)/documents/itlab_posts/$(c.postId)).data;
      return own(c.authorId) || admin() || categoryModerator(post.category)
        || (own(post.authorId) && post.get('deleting', false) == true)
        || ('parentId' in c && own(get(/databases/$(database)/documents/itlab_comments/$(c.parentId)).data.get('deletingBy', '')));
    }
    function commentCounterChanged(postId) {
      let commentId = request.resource.data.lastCommentId;
      let path = /databases/$(database)/documents/itlab_comments/$(commentId);
      let beforeCount = resource.data.get('commentCount', 0);
      let afterCount = request.resource.data.commentCount;
      return changedOnly(['commentCount','lastCommentId']) && commentId is string
        && afterCount is int && afterCount >= 0
        && ((!exists(path) && existsAfter(path) && getAfter(path).data.postId == postId
          && getAfter(path).data.authorId == request.auth.uid && afterCount == beforeCount + 1)
        || (exists(path) && !existsAfter(path) && get(path).data.postId == postId
          && canDeleteComment(get(path).data) && afterCount == beforeCount - 1));
    }
    function pairedCounter(postId, commentId, delta) {
      let before = get(/databases/$(database)/documents/itlab_posts/$(postId)).data;
      let after = getAfter(/databases/$(database)/documents/itlab_posts/$(postId)).data;
      return after.get('lastCommentId', '') == commentId
        && after.commentCount == before.get('commentCount', 0) + delta;
    }
    match /itlab_users/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['displayName','email','photoURL','lastSeen'])
        && text(request.resource.data.displayName, 200)
        && request.resource.data.lastSeen == request.time;
      allow update: if admin() || (own(uid) && (
        (changedOnly(['displayName','email','photoURL','lastSeen','updatedAt'])
          && text(request.resource.data.displayName, 200))
        || (changedOnly(['chatAuthorized']) && request.resource.data.chatAuthorized == true
          && existsAfter(/databases/$(database)/documents/itlab_chat_access/$(uid)))
      ));
      allow delete: if false;
    }
    match /itlab_settings/{id} {
      allow get: if id in ['general','categories'];
      allow list: if admin();
      allow create, update: if admin() && id in ['general','categories'];
      allow delete: if false;
    }
    match /itlab_posts/{id} {
      allow read: if true;
      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['title','content','category','tags','authorId','authorName','authorAvatar','likes','likedBy','commentCount','isPinned','isFeatured','createdAt','updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && text(request.resource.data.title, 500) && text(request.resource.data.content, 200000)
        && text(request.resource.data.category, 100) && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.likes == 0 && request.resource.data.likedBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.isPinned == false && request.resource.data.isFeatured == false
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        ((own(resource.data.authorId) || admin())
          && changedOnly(['title','content','category','tags','lastEditedAt','lastEditedBy'])
          && text(request.resource.data.title, 500) && text(request.resource.data.content, 200000)
          && text(request.resource.data.category, 100) && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 5
          && request.resource.data.lastEditedBy == request.auth.uid && request.resource.data.lastEditedAt == request.time)
        || ((admin() || categoryModerator(resource.data.category))
          && changedOnly(['isPinned','isFeatured'])
          && request.resource.data.isPinned is bool && request.resource.data.isFeatured is bool)
        || (changedOnly(['likes','likedBy']) && validLike())
        || commentCounterChanged(id)
        || ((own(resource.data.authorId) || admin() || categoryModerator(resource.data.category))
          && changedOnly(['deleting']) && request.resource.data.deleting == true)
      );
      function validLike() {
        let old = resource.data.likedBy;
        let next = request.resource.data.likedBy;
        let uid = request.auth.uid;
        return old is list && next is list && next.size() == next.toSet().size()
          && request.resource.data.likes is int && request.resource.data.likes == next.size()
          && ((!(uid in old) && next.toSet() == old.toSet().union([uid].toSet()) && next.size() == old.size() + 1)
            || (uid in old && next.toSet() == old.toSet().difference([uid].toSet()) && next.size() == old.size() - 1));
      }
      allow delete: if (own(resource.data.authorId) || admin() || categoryModerator(resource.data.category))
        && resource.data.get('deleting', false) == true && resource.data.get('commentCount', 0) == 0;
    }
    match /itlab_comments/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId','content','authorId','authorName','authorAvatar','createdAt','parentId','replyTo'])
        && request.resource.data.authorId == request.auth.uid
        && text(request.resource.data.content, 50000)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/itlab_posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/itlab_posts/$(request.resource.data.postId)).data.get('deleting', false) == false
        && pairedCounter(request.resource.data.postId, id, 1)
        && (!('parentId' in request.resource.data)
          || (get(/databases/$(database)/documents/itlab_comments/$(request.resource.data.parentId)).data.postId == request.resource.data.postId
            && get(/databases/$(database)/documents/itlab_comments/$(request.resource.data.parentId)).data.get('deleting', false) == false));
      allow update: if ((admin() || categoryModerator(get(/databases/$(database)/documents/itlab_posts/$(resource.data.postId)).data.category))
        && changedOnly(['isPinned']) && request.resource.data.isPinned is bool)
        || (signedIn() && canDeleteComment(resource.data) && changedOnly(['deleting','deletingBy'])
          && request.resource.data.deleting == true && request.resource.data.deletingBy == request.auth.uid);
      allow delete: if signedIn() && canDeleteComment(resource.data) && pairedCounter(resource.data.postId, id, -1);
    }
    match /itlab_invitations/{code} {
      allow get: if signedIn();
      allow list: if admin();
      allow create: if admin() && request.resource.data.keys().hasOnly(['code','type','isUsed','createdBy','createdAt'])
        && request.resource.data.code == code && request.resource.data.isUsed == false
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.get('type', '') == 'chat'
        && resource.data.isUsed == false && changedOnly(['isUsed','usedBy','usedAt'])
        && request.resource.data.isUsed == true && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/itlab_chat_access/$(request.auth.uid)).data.usedCode == code
        && getAfter(/databases/$(database)/documents/itlab_chat_access/$(request.auth.uid)).data.userId == request.auth.uid;
      allow delete: if admin();
    }
    match /itlab_chat_access/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['userId','authorizedAt','usedCode'])
        && request.resource.data.userId == uid && request.resource.data.authorizedAt == request.time
        && validClaim(request.resource.data.usedCode, uid);
      allow update: if false;
      allow delete: if admin();
    }
    match /itlab_chat_messages/{id} {
      allow read: if chatOpen();
      allow create: if chatOpen()
        && request.resource.data.keys().hasOnly(['userId','userName','userAvatar','content','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && text(request.resource.data.userName, 200) && text(request.resource.data.content, 20000)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if own(resource.data.userId) || admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
